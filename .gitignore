# =========================================================================
# Unity General Exclusions
# =========================================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/
VersionControl/
AssetStoreTools/

# =========================================================================
# XR, OpenXR, and Platform Specifics (Meta Quest/Android/PCVR)
# =========================================================================
*.keystore
*.jks

# Only ignore XR/platform build output, never committed plugin binaries.
# If your XR SDKs (Meta/Oculus, OpenXR, etc.) ship native runtime .dll/.so/.aar
# files under Assets/Plugins/, those must stay tracked - do NOT blanket-ignore
# *.dll or *.exe anywhere in Assets/.
/[Bb]uilds/**/*.exe
/[Bb]uilds/**/*.dll
/[Bb]uilds/**/*.apk
/[Bb]uilds/**/*.aab

# Double-check these two before keeping them - see notes below
.xr/
Assets/XR/Tunables/

# =========================================================================
# Visual Studio Code & Visual Studio Community Exclusions
# =========================================================================
.vscode/
.vs/
*.suo
*.user
*.userprefs
*.sln.docstates

# Compiled/debug files (NOT scoped to Assets/, so committed plugin
# binaries under Assets/Plugins/ are unaffected)
*.pdb
*.opendb
*.VC.db
*.ilk

# =========================================================================
# Unity Autogenerated IDE Project Files (Safe for VS, VS Code, & Rider)
# =========================================================================
*.csproj
*.unityproj
*.sln
*.pidb
*.booproj
*.svd

# =========================================================================
# OS and System Generated Files
# =========================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# =========================================================================
# Crash and Diagnostic Logs
# =========================================================================
syslog.txt
sysinfo.txt
crash_reporterlogs/
crashlytics-build.properties